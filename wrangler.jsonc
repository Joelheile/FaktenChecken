{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fakten-checken",
  "main": "./worker/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "routes": [
    { "pattern": "fakten.joels.tech", "custom_domain": true },
    { "pattern": "fakten-checken.de", "custom_domain": true },
    { "pattern": "www.fakten-checken.de", "custom_domain": true }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
