# Server-side API keys (used by Vercel serverless functions)
# These do NOT need the VITE_ prefix since they run server-side

# Apify API token for TikTok transcription
# Get it from https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_token_here

# OpenAI API key for fact checking
# Get it from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Neon Postgres connection string (anonymized analytics dataset)
# Get it from https://console.neon.tech (Connection Details, pooled)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# PostHog project API key (client-side analytics). Safe to expose: it is a
# write-only ingest key. The VITE_ prefix exposes it to the browser bundle.
VITE_POSTHOG_API_KEY=your_posthog_project_key_here

# Impressum (legally required site owner details, shown on /impressum)
VITE_IMPRESSUM_NAME=Max Mustermann
VITE_IMPRESSUM_STREET=Musterstraße 1
VITE_IMPRESSUM_CITY=10115 Berlin
VITE_IMPRESSUM_PHONE=+49 30 1234567
VITE_IMPRESSUM_EMAIL=max@example.com
VITE_IMPRESSUM_VAT_ID=DE123456789
