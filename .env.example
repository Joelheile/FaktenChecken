# Server-side API keys (used by Vercel serverless functions)
# These do NOT need the VITE_ prefix since they run server-side

# Apify API token for TikTok transcription
# Get it from https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_token_here

# OpenAI API key for fact checking
# Get it from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
